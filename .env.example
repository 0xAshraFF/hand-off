# Handoff planner configuration
# The app works without a planner API key using the deterministic budget router.

# Easiest option: DeepSeek planner fallback
DEEPSEEK_API_KEY=""

# Generic OpenAI-compatible planner override.
# Use this for GLM, OpenRouter, DeepSeek, or another compatible provider.
PLANNER_API_KEY=""
PLANNER_BASE_URL=""
PLANNER_MODEL=""

# Example OpenRouter configuration:
# PLANNER_BASE_URL="https://openrouter.ai/api/v1"
# PLANNER_MODEL="<provider/model-id>"

# Optional application URL for deployments.
APP_URL=""
